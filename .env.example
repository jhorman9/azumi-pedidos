# Credenciales del administrador. En produccion la contrasena requiere 12 caracteres.
AZUMI_ADMIN_EMAIL=admin@azumi.example
AZUMI_ADMIN_PASSWORD=replace-with-your-own-long-password

# Produccion en Hostinger con MySQL/MariaDB.
# Configura estos valores como variables de entorno del hosting, no en codigo.
# AZUMI_DATABASE_DRIVER=mysql
# AZUMI_MYSQL_HOST=127.0.0.1
# AZUMI_MYSQL_PORT=3306
# AZUMI_MYSQL_DATABASE=database_azumi
# AZUMI_MYSQL_USER=user_database
# AZUMI_MYSQL_PASSWORD=replace-with-your-hosting-password

# Ruta opcional a SQLite. Si no activas MySQL, la app usa SQLite para desarrollo local.
# AZUMI_DATABASE_PATH=./data/azumi.sqlite
