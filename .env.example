# Credenciales del administrador. En produccion la contrasena requiere 12 caracteres.
AZUMI_ADMIN_EMAIL=admin@azumi.example
AZUMI_ADMIN_PASSWORD=replace-with-your-own-long-password

# Produccion en Hostinger con MySQL/MariaDB.
# Configura estos valores como variables de entorno del hosting, no en codigo.
# AZUMI_DATABASE_DRIVER=mysql
# AZUMI_MYSQL_HOST=127.0.0.1
# AZUMI_MYSQL_PORT=3306
# AZUMI_MYSQL_DATABASE=database_azumi
# AZUMI_MYSQL_USER=user_database
# AZUMI_MYSQL_PASSWORD=replace-with-your-hosting-password

# Ruta opcional a SQLite. Si no activas MySQL, la app usa SQLite para desarrollo local.
# AZUMI_DATABASE_PATH=./data/azumi.sqlite

# URL publica real; necesaria para recuperar contrasenas y para proxies del hosting.
# AZUMI_APP_URL=https://tu-dominio.com

# Push: las claves VAPID se crean y conservan automaticamente en la base de datos.
# Opcional: proporciona ambas para usar claves propias estables.
# AZUMI_VAPID_PUBLIC_KEY=
# AZUMI_VAPID_PRIVATE_KEY=
# AZUMI_VAPID_SUBJECT=mailto:pedidos@tu-dominio.com

# Correo del restaurante para recibir pedidos y enviar confirmaciones.
# AZUMI_SMTP_HOST=smtp.hostinger.com
# AZUMI_SMTP_PORT=465
# AZUMI_SMTP_USER=pedidos@tu-dominio.com
# AZUMI_SMTP_PASSWORD=replace-with-your-mailbox-password
# AZUMI_MAIL_FROM=Azumi <pedidos@tu-dominio.com>
# AZUMI_RESTAURANT_EMAIL=pedidos@tu-dominio.com

# Opcional: endpoint de busqueda Nominatim propio o de un proveedor.
# AZUMI_GEOCODER_URL=https://nominatim.openstreetmap.org/search

# Geoapify: clave privada del servidor para busqueda y autocompletado.
# Configura esta variable tambien en Hostinger, sin prefijo NEXT_PUBLIC_.
# AZUMI_GEOAPIFY_API_KEY=
